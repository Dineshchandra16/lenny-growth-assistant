# =============================================================================
# Lenny Growth Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# --- Database ---
POSTGRES_USER=lenny
POSTGRES_PASSWORD=lenny_secret
POSTGRES_DB=lenny_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Full async URL used by SQLAlchemy (auto-built from above in config.py;
# override here if using an external DB like Supabase or Railway)
# DATABASE_URL=postgresql+asyncpg://lenny:lenny_secret@db:5432/lenny_db

# --- LLM Provider Selection ---
# Options: "ollama" | "anthropic" | "openai"
DEFAULT_LLM_PROVIDER=ollama

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
# Model to use with Ollama
OLLAMA_MODEL=llama3.2:3b

# --- Anthropic (optional — required only if DEFAULT_LLM_PROVIDER=anthropic) ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- OpenAI (optional — required only if DEFAULT_LLM_PROVIDER=openai) ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# --- Embeddings ---
# "local" uses sentence-transformers/all-MiniLM-L6-v2 (downloaded on first run)
# "ollama" uses nomic-embed-text via Ollama
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=all-MiniLM-L6-v2

# --- RAG Retrieval ---
# Number of top-K chunks to retrieve per query
RAG_TOP_K=5
# Minimum cosine similarity score (0.0–1.0) to include a chunk
RAG_SIMILARITY_THRESHOLD=0.30
# Chunk size in tokens
CHUNK_SIZE=600
# Chunk overlap in tokens
CHUNK_OVERLAP=100

# --- API ---
# Allowed CORS origin (set to your frontend URL in production)
FRONTEND_ORIGIN=http://localhost:3000
# Internal API host/port
API_HOST=0.0.0.0
API_PORT=8000

# --- Logging ---
# Options: "json" | "text"  (json recommended for production)
LOG_FORMAT=json
LOG_LEVEL=INFO

# --- Security ---
# Set to "production" to enforce stricter settings
APP_ENV=development
